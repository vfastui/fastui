{
    "name": "@vfastui/fastui",
    "version": "0.1.2",
    "description": "vue ui component",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "doc:dev": "vitepress dev docs --host 0.0.0.0",
        "doc:build": "vitepress build docs",
        "doc:preview": "vitepress preview docs",
        "clean": "rimraf dist",
        "build:css": "gulp --gulpfile build/gen-css.js",
        "build:components": "rollup -c",
        "build": "npm run clean && npm run build:css && npm run build:components && sh ./build/build.sh"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vfastui/fastui.git"
    },
    "sideEffects": false,
    "author": "airene",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vfastui/fastui/issues"
    },
    "homepage": "https://github.com/vfastui/fastui#readme",
    "devDependencies": {
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/node": "^25.0.6",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vue/compiler-sfc": "^3.5.26",
        "@vueuse/core": "^14.1.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-vue": "^10.6.2",
        "gulp": "^5.0.1",
        "gulp-autoprefixer": "^10.0.0",
        "gulp-clean-css": "^4.3.0",
        "gulp-less": "^5.0.0",
        "gulp-rename": "^2.1.0",
        "less": "^4.5.1",
        "prettier": "^3.7.4",
        "rimraf": "^6.1.2",
        "rollup": "^4.55.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-less": "^1.1.3",
        "rollup-plugin-vue": "^6.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitepress": "^2.0.0-alpha.15",
        "vue": "^3.5.26",
        "vue-tsc": "^3.2.2"
    }
}
